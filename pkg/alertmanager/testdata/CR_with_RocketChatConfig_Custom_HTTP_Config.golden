route:
  receiver: "null"
  routes:
  - receiver: mynamespace/myamc/test
    matchers:
    - namespace="mynamespace"
    continue: true
receivers:
- name: "null"
- name: mynamespace/myamc/test
  rocketchat_configs:
  - http_config:
      basic_auth:
        username: user
        password: pass
      follow_redirects: true
    token_id: my-token-id
    token: my-token
    channel: '#alerts'
    short_fields: false
    link_names: false
templates: []
